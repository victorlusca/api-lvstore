# ─────────────────────────────────────────────────────────────────────────────
# API — exemplo de configuracao. Copie para `.env` (gitignorado) e preencha.
# Em producao, defina no painel da hospedagem.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# 1 liga o modo debug. Em producao MANTENHA 0:
#   - com 1, /docs (Swagger) fica publico e documenta toda a API;
#   - com 1, respostas 500 incluem a mensagem interna e o traceback completo;
#   - com 1, main.py sobe o uvicorn com --reload (WatchFiles), que nao deve
#     rodar em producao.
API_DEBUG=0

# Diretorio local de dados da API. A API le o banco do BOT pela Square Cloud;
# este diretorio guarda apenas estado proprio da API.
API_DATA_DIR=data

# ── Seguranca ───────────────────────────────────────────────────────────────
# Chave-mestra: concede escopo admin:* (inclusive leitura/escrita de arquivos
# de qualquer app da Square Cloud). Sem valor padrao no codigo, de proposito.
# Vazia = master key desligada; apenas tokens de api_tokens sao aceitos.
# Gere um valor unico por ambiente:  python -c "import secrets;print(secrets.token_hex(32))"
API_KEY=
API_SETUP_KEY=

# Bloqueio por tentativas de token invalido (por IP de conexao).
API_BF_MAX_FAILURES=10
API_BF_WINDOW_SECS=300

# ── CORS ────────────────────────────────────────────────────────────────────
# Observacao: a lista de origens permitidas esta fixa em app/main.py.
# Esta variavel existe no exemplo por historico e hoje nao e lida.
API_CORS_ORIGINS=

# ── Square Cloud ────────────────────────────────────────────────────────────
SQUARECLOUD_API_TOKEN=
SQUARECLOUD_APP_ID=

# ── Site ────────────────────────────────────────────────────────────────────
SITE_URL=
